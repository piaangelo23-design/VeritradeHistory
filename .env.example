# ============================================================
# MM2 Tracker - Combined environment example
# Copy to .env and fill in your values
# ============================================================

# Discord Bot (server-side only - NEVER expose in frontend)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
TRADE_CHANNEL_ID=YOUR_TRADE_CHANNEL_ID
ADMIN_DISCORD_IDS=YOUR_DISCORD_USER_ID

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mm2_tracker

# Backend
BACKEND_URL=http://localhost:3000
API_SECRET=CHANGE_THIS_SECRET
JWT_SECRET=CHANGE_THIS_JWT_SECRET
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_BCRYPT

# Trade Tracking
SYNC_INTERVAL=60
TRADE_FEED_INTERVAL=15
TRACKING_ENABLED=true
AUTO_TRADES_ENABLED=true
DISCORD_MEMBER_BASELINE=34000
WEBSITE_VISIT_BASELINE=90000
SMALL_TRADE_BASELINE=2364
MEDIUM_TRADE_BASELINE=2136
LARGE_TRADE_BASELINE=1972

# Site
DISCORD_INVITE=https://discord.gg/HpPSfvjmmT

# Neblio / MM2 Data Provider (optional - use only authorized APIs)
NEBLIO_API_BASE=
NEBLIO_ENABLED=true
# Only use an authorized API/feed/export. This project does not scrape Traderie.

# Roblox verification (bot)
ROBLOX_VERIFY_ENABLED=false
ROBLOX_VERIFY_REFRESH_HOURS=24
ENABLE_PRESENCE_INTENT=false
